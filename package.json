{
  "name": "geoxpl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "batch": "node --env-file-if-exists=.env scripts/batch-import.js",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-password.js",
    "boundary:download": "node scripts/download-boundary.js"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-shortest-path": "^2.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
